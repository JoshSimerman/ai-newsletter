# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Cloudflare D1 — pipeline state, research archive, and 7-day dedup index
CF_ACCOUNT_ID=00000000000000000000000000000000
CF_API_TOKEN=your-cloudflare-api-token
CF_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Public URL of your Cloudflare Pages site (no trailing slash).
# Used for canonical/og:url tags and post-deploy verification. Optional.
SITE_URL=https://example.com

# YouTube Data API v3 (optional — enables the YouTube Creators section)
YOUTUBE_API_KEY=your-youtube-data-api-key
